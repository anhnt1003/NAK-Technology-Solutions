# Copy to .env for local dev. On Hostinger, set these in hPanel > Node.js > Environment variables.
NODE_ENV=production
SITE_URL=https://www.nak.com.vn

# Optional: shown on the site only when set
COMPANY_EMAIL=support@nak.com.vn
COMPANY_PHONE=0937 212 288

# Contact form -> email (create the mailbox in Hostinger Emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@nak.com.vn
SMTP_PASS=change-me
MAIL_TO=support@nak.com.vn
