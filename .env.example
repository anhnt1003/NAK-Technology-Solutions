# Copy to .env for local dev. On Hostinger, set these in hPanel > Node.js > Environment variables.
NODE_ENV=production
PORT=3000
SITE_URL=https://your-domain.com

# Company details shown on the site
COMPANY_EMAIL=info@your-domain.com
COMPANY_PHONE=+84 000 000 000
COMPANY_ADDRESS_VI=Địa chỉ công ty, Thành phố, Việt Nam
COMPANY_ADDRESS_EN=Company address, City, Vietnam

# Contact form -> email (create a mailbox in Hostinger Emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@your-domain.com
SMTP_PASS=change-me
MAIL_TO=info@your-domain.com
