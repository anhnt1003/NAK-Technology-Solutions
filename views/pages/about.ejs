<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="page-hero photo-hero" style="--photo:url(/img/photos/building.jpg)">
  <div class="orb orb-b" aria-hidden="true"></div>
  <div class="container">
    <p class="eyebrow hero-in"><span class="dot"></span><%= t.about.eyebrow %></p>
    <h1 class="hero-in"><%= t.about.title %></h1>
    <p class="lead hero-in"><%= t.about.lead %></p>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div class="split-text reveal">
      <p class="sub"><%= t.about.story %></p>
      <div class="facts">
        <% t.about.facts.forEach(function (f) { %><div><strong class="grad"><%= f.value %></strong><span><%= f.label %></span></div><% }) %>
      </div>
    </div>
    <figure class="photo-card reveal" style="--d:100ms"><img src="/img/photos/glass.jpg" alt="" loading="lazy" width="800" height="600"></figure>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <blockquote class="mission reveal">
      <p class="eyebrow"><%= t.about.missionLabel %></p>
      <p class="mission-text"><%= t.about.mission %></p>
    </blockquote>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head reveal"><h2><%= t.about.deliveryHead %></h2></div>
    <ol class="steps six">
      <% t.delivery.forEach(function (p, i) { %>
      <li class="step reveal" style="--d:<%= i * 70 %>ms">
        <span class="step-num"><%= String(i + 1).padStart(2, '0') %></span>
        <div class="card-icon sm"><%- icon(p.icon, 24) %></div>
        <h3><%= p.title %></h3>
        <p><%= p.text %></p>
      </li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head reveal"><h2><%= t.about.whyHead %></h2></div>
    <div class="card-grid four">
      <% t.why.forEach(function (w, i) { %>
      <div class="card reveal" style="--d:<%= i * 80 %>ms">
        <div class="card-icon sm"><%- icon(w.icon, 24) %></div>
        <h3><%= w.title %></h3>
        <p><%= w.text %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<% if (content.extras.team.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head reveal"><h2><%= t.x.teamHead %></h2></div>
    <div class="card-grid four">
      <% content.extras.team.forEach(function (m) { %>
      <div class="card reveal"><% if (m.photo) { %><img class="avatar" src="<%= m.photo %>" alt="" loading="lazy"><% } %><h3><%= m.name %></h3><p><%= m[lang].role %></p></div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
<% if (content.extras.sla) { %>
<section class="section">
  <div class="container">
    <div class="section-head reveal"><h2><%= t.x.slaHead %></h2></div>
    <dl class="sla-list reveal"><% content.extras.sla[lang].forEach(function (r) { %><div><dt><%= r.label %></dt><dd><%= r.value %></dd></div><% }) %></dl>
  </div>
</section>
<% } %>

<%- include('../partials/cta', { ctaTitle: t.about.ctaTitle, ctaText: t.about.ctaText, ctaBtn: t.about.ctaBtn }) %>

<%- include('../partials/footer') %>
